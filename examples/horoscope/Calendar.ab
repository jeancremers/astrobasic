window(0, 0);
copyhoroscope(-1, 0);
real findjdx; ` structure for findaspectx
char findtypex, findp1x, findp2x, findaspx;
real findr1x, findr2x, findorbx, velo[14], dec[PLANETS], oob;
char planet1[13], planet2[PLANETS], asp1[ASPECTS], opt1[12];

real findjd; ` structure for findaspect
char findtype, findp1, findp2, findasp;
real findr1, findr2, findorb, start, end;
char domax, hasput, donoon, doecl, t[256], dotzday, pieces[12][120], buf[9999], pname[PLANETS][4] = "sun", "moo", "mer", "ven", "mar", "jup", "sat", "ura", "nep", "plu", "nod", "chi", "lil", "par", "asc", "mc", aname[ASPECTS][4] = "con", "sex", "squ", "tri", "inc", "opp", "sem", "hal", "sep", "qui", "ses", textfile[256] = "Transit 2 Radix Author @ Michael Erlewine.txt", dotz, domoonphase, usebirth, dosunset = 1, domoonset = 1, dolap, docusp, housepos[PLANETS], dohou, planet[16] = "1111111111", asp[11] = "111101", ops[20], place[67], yearstr[22], s[99], ds[22], ts[22], dummy[0][0], inifile[256] = "calendar.ini", decname[2][9] = "//", "#", dodec = 1, doing = 1, doret = 1, doretx = 1, retronames[2][22] = "retro", "direct", dooob = 1, dooobx = 1, oobnames[2][22] = "Oob", "Inb", dovoc = 1, docol = 1, doprog = 1, cal, moonasp[ASPECTS], dorot, hd = if (width > 1400);
int forecolor, k, tot[32], pl1[32][32], pl2[32][32], as[32][32], type, i, j, n, count, x, y, time[6], time1[6], day, mon, foundtime[6], xp[33], yp[33], monthndx, color, oldxp = -1, oldxp1 = -1, m = 0, m1 = 0, xp1[32], yr[33], col, row, maxn, size = fontsize(100), xxx = 15 * if (height > 1100);
real jd, jd1, zone, lon, lat, w = width / 7, h = height / 6, progstart, birth, progend;
real ecjd, ecmagnit, ecmoon, ecnode;          ` structure for findeclipse
char ecnorth, eckind, ectype, ecsarosn;
short ecsaros1, ecsaros2;
include "moonphases.ab";
@seteclbitmaps;
memget(0, 1000, 36); ` findaspect(x)
memget(1, 10, 40); ` findeclipse
command(FUNCTION, 66, 0, 0);
gethoroscopetime(0, time, birth);
getsystemtime(time);
menu(0, "Calendar", do);
menu(0, "Options", do);
menu(0, "Place", place);
menu(0, "Close", close);
menu(0, "-", NULL);
menu(0, "Color Red", col);
menu(0, "Color Yellow", col);
menu(0, "Color Green", col);
menu(0, "Color Blue", col);
menu(0, "Remove Color", col);
menu(0, "-", NULL);
i = menu(0, "Help", NULL) + 1;
menu(i, "English", help);
menu(i, "Nederlands", helpnl);
button(width - 60, height - 50, "&Menu", NULL);
command(BUTTON, buttonnumber, 10, 0);
command(BUTTON, buttonnumber, WIDTH, 60);
command(MENU, 0, 12, 0);
updown(width - 80, height - 25, 0, ud);
command(UPDOWN, 0, 6, 1);
command(UPDOWN, 0, WIDTH, 80);
i = 0; for (i < 6)
  {
  asp1[i] = 1;
  moonasp[i] = 1;
  }
i = 0; for (i < 10)
  {
  planet1[i] = 1;
  planet2[i] = 1;
  }
label(width - 300, height - 25, "");
strcpy(place, defaultplace);
@load;
`time[1] = 12;
monthndx = time[1] - 1;
strnum(yearstr, time[0], 0);
menunumber = 0;
gethousepos(0, housepos);
setname(1, "Calendar");
onclose(save);
mousedown(md);
strset(s, "%sab\language\%s", home, textfile);
findfilestr(0, s, ""); ` init
setsymbolsize(0);
@do;
run;

:col;
  i = @getday(mousex / w, mousey / h);
  switch (menunumber)
    {
    :5; n = RED; break;
    :6; n = YELLOW; break;
    :7; n = LIME; break;
    :8; n = BLUE; break;
    :9; n = -1; break;
    }
  box(xp[i] * w,     yp[i] * h,     w + 1, h + 1, n, 1);
  if (menunumber = 9) n = -2;
  box(xp[i] * w + 1, yp[i] * h + 1, w - 1, h - 1, n, 1);
  box(xp[i] * w + 2, yp[i] * h + 2, w - 3, h - 3, n, 1);
  return;

:put;                                                          ` options
  group(1);
  combobox(30, 30, 100, dummy, monthndx, NULL);
  i = 0; for (i < 12)
    command(COMBO, 0, 16, &monthname[i]);                       ` add months
  command(COMBO, 0, 6, time[1] - 1);
  edit(150, 30, 100, yearstr, NULL);

  i = 0; for (i < SIGNS)
    signname[i][4] = 0;
  label(480, 40, "Transit");
  i = 0; for (i < PARS)
    checkbox(495, 65 + i * 20, "", planet1[i], NULL);   ` planet1 = transit, planetp = prog, planet2 is radix
  label(535, 40, "Radix");
  i = 0; for (i < PLANETS)
    checkbox(535, 65 + i * 20, "", planet2[i], NULL);
  label(605, 40, "All");
  i = 0; for (i < ASPECTS)
    checkbox(605, 65 + i * 20, "", asp1[i], NULL);
  label(640, 40, "Moon");
  i = 0; for (i < ASPECTS)
    checkbox(640, 65 + 20 * i, "", moonasp[i], NULL);
  button(480, 400, "Texts", gettext);
  label(480, 430, "");
  label(40, 80, "Show");
  checkbox(40, 110, "House Ingress", docusp, NULL);
  checkbox(40, 140, "Progression", doprog, NULL);
  checkbox(40, 170, "Declination", dodec, NULL);
  checkbox(40, 200, "Ingress", doing, NULL);
  checkbox(40, 230, "Retro", doret, NULL);
  checkbox(40, 260, "Oob", dooob, NULL);
  checkbox(40, 290, "Zero / Max", domax, NULL);
  checkbox(40, 320, "Void of course", dovoc, NULL);
  hint("Ingress should also be selected if you want Voc");
  checkbox(40, 350, "House cusps", dohou, NULL);
  checkbox(40, 380, "Sun rise/set", dosunset, NULL);
  checkbox(40, 410, "Moon rise/set", domoonset, NULL);
  checkbox(40, 440, "Timezone", dotz, NULL);
  checkbox(40, 470, "Timezone changes", dotzday, NULL);
  checkbox(40, 500, "Moonphase", domoonphase, NULL);
  checkbox(40, 530, "Eclipse", doecl, NULL);
  checkbox(40, 560, "Always show retro", doretx, NULL);
  checkbox(40, 590, "Always show oob", dooobx, NULL);
  button(40, 620, "Go", cal);

  label(240, 80, "Options");
  checkbox(240, 110, "Rotate", dorot, NULL);
  hint("Shows weeks as columns or as rows.");
  checkbox(240, 140, "Prevent overflow", dolap, NULL);
  hint("Check this if you have overlap. It decreases the maximum allowed number of events on a day with one.");
  checkbox(240, 170, "Use birth place", usebirth, NULL);
  checkbox(240, 200, "Color", docol, NULL);
  checkbox(240, 230, "Transit at noon", donoon, NULL);
  label(240, 260, "Font");
  updownx(320, 260, 1, NULL, 1, 30, 1, &size);
  @settext;
  hasput = 1;
  return;

:settext;
  strset(s, "%sab\language\%s", home, textfile);
  labelset(5, textfile);
  findfilestr(0, s, ""); ` init
  return;

:gettext;
  strset(t, "%sab\language\%s", home, textfile);
  if (getfilename("Open an interpretation file", "PlanetDance Interpretation files (*.txt)|*.txt", t, 1, FILEREAD, 0) = 1)
    {
    setfilename(t, "", textfile, 2);
    @save;
    @settext;
    }
  return;

#getday(int x, int y)
{
int i = 1; for (i < 32)
  {
  if (xp[i] = x && yp[i] = y)
    return i;
  }
return 0;
}
                                                                                    ` mousedown
:md;
  if (isbit(mouseinfo, 3) = 1 || isbit(mouseinfo, 5) = 1)
    {
    i = @getday(mousex / w, mousey / h);
    if (i = 0) return;
    set(time, 0);
    time[0] = numstr(yearstr);
    time[1] = monthndx + 1;
    time[2] = i;
    time[3] = 12 * donoon;
    timetostring(time, ds, ts, 0);
    canvas(900, 520, 0, 0, ds);
    jd = timetojulian(time) - zone;
    if (isbit(mouseinfo, 5) = 1)
      {
      setcanvascaption(ds);
      calculate(1, jd, lon, lat, -1);
      sethoroscopeplace(1, place);
      zone = gettimezone(place, jd);
      sethoroscopetime(1, jd, zone);
      setbit(type, 8, 1);
      drawhoroscopex(1, 0, type, 0, 0, 900, 520, 0);
      }
    else
      {
      m1 = 0;
      strset(s, "%s %s", ds, textfile);
      setcanvascaption(s);
      count = tot[i - 1]; j = 0; for (j < count)
        {
        int pp1 = pl1[i - 1][j], pp2 = pl2[i - 1][j], as1 = as[i - 1][j];
        if (as1 < 0)
          strset(s, "%s %d", pname[pp1], pp2);
        else
          strset(s, "%s %s %s", pname[pp1], aname[as1], pname[pp2]);
        if (findfilestr(1, s, buf) = 1)
          {
          if (as1 < 0)
            strset(s, "%p in %d", pp1, pp2);
          else
            strset(s, "%p %e %p", pp1, as1, pp2);
          putsymbolstring(5, 5 + m1 * 16, s);
          m = strcmd(31, 99, buf);    ` wordwrap string
          if (m > 11) m = 11;
          split(buf, pieces, 10);
          k = 0; for (k < m)
            putstring (80, 5 + (m1 + k) * 16, pieces[k]);
          m1 += m;
          }
        }
      }
    canvasclose;
    }
  return;

:cal;
  @save;
  menunumber = 0;
  @do;
  return;

:go;
  if (usebirth = 1)
    gethoroscopeplace(0, place, 0);   ` place is set here so the place in @load is ignored
  col = 7 - dorot;
  row = 6 + dorot;
  w = width / col;
  h = height / row;
  maxn = h / 18 - dolap;
  set(time, 0);
  time[0] = numstr(yearstr);
  time[1] = monthndx + 1;
  time[2] = 1; ` first of month
  mon = time[1];
  getname(0, s);
  strset(s, "%s %s %d", s, monthname[mon - 1], time[0]);
  setcaption(s);
  getname(0, s);
  strset(s, "%s %s %d", s, monthname[mon - 1], time[0]);
  labelset(0, s);
  jd = timetojulian(time);
  start = jd;
  zone = gettimezone(place, jd);
  sethoroscopeplace(1, place);
  getlonlat(1, lon, lat);
  day = @dayofweek(jd + zone);
  visible(0);
  x = 0; for (x < col)
    line(x * w, 0, x * w, height, -1);
  y = 0; for (y < row)
    line(0, y * h, width, y * h, -1);
  i = 1;
  if (dorot = 0)
    { x = day; y = 0; }
  else
    { x = 0; y = day; }
`----------------------------------------------------------------------------------------- fill xp[] yp[]
`  fontsize(size);
  while (mon = time[1])
    {
    fontsize(105);
    putnumber(3 + x * w, 3 + y * h, i);
    fontsize(0);
    xp[i] = x;
    yp[i] = y;
    if (docol = 1)
      {
      color = signcolor[getplanetx(jd + 1, SUN, 0) / 30];
      box(xp[i] * w, yp[i] * h, w, h, color, 1);
      }
    if (dorot = 0)
      {
      x += 1;
      if (x = col)
        {
        x = 0;
        y += 1;
        }
      }
    else
      {
      y += 1;
      if (y = row)
        {
        y = 0;
        x += 1;
        }
      }
    i += 1;
    jd += 1;
    juliantotime(jd + zone, time);
    }
`----------------------------------------------------------------------------------------- tz moonphase rise set
  jd = start;
  juliantotime(jd, time);
  mon = time[1];
  set(yr, 0);
  if (dotzday = 1)
    {
    int monthlen = command(FUNCTION, 111, mon - 1, 0);
    i = 1; for (i <= monthlen)
      {
      zone = gettimezone(place, jd);
      jd1 = command(FUNCTION, 108, &jd, &place);
      if (jd1 > -1)
         {
         juliantotime(jd1, time1);
         timetostring(time1, ds, ts, 1);
         zone = gettimezone(place, jd + 1);
         sethoroscopetime(1, jd + 1, zone); ` get tzname for next day
         strcmd(30, 1, s);              ` these 2 get CET +1:00
         strset(s, "%s %s", s, ts);
         @getxy;
         putstring(x, y, s);
         }
      jd += 1;
      }
    }
  while (mon = time[1])
    {
    n = time[2];
    jd = timetojulian(time);
    if (dotz = 1)
     {
     zone = gettimezone(place, jd);
     jd1 = command(FUNCTION, 108, &jd, &place); ` check if there's a timezone transition this day
     if (jd1 > -1)
       {
       juliantotime(jd1, time1);
       timetostring(time1, ds, ts, 1);
       putstring(x + 100, y, ts);
       zone = gettimezone(place, jd + 1);
       sethoroscopetime(1, jd + 1, zone); ` get tzname for next day
       }
     else
       sethoroscopetime(1, jd, zone);
     strcmd(30, 1, s);              ` these 2 get CET +1:00
     @getxy;
     putstring(x, y, s);
     }
    if (domoonphase = 1)
     {
     @getxy;
     @moonphase(x, y, jd);
     }
    if (dosunset = 1)
     {
     @getxy;
     putplanet(x, y, SUN);
     @putriseset(x + 18, y, jd - zone, 1, n, SUN);
     putstring(x + 60, y, "-");
     @putriseset(x + 66, y, jd - zone, 0, n, SUN);
     }
    if (domoonset = 1)
     {
     @getxy;
     putplanet(x, y, MOON);
     @putriseset(x + 18, y, jd - zone, 1, n, MOON);
     putstring(x + 60, y, "-");
     @putriseset(x + 66, y, jd - zone, 0, n, MOON);
     }
    jd += 1;
    juliantotime(jd, time);
    }


`----------------------------------------------------------------------------------------- transit - radix events
  end = start + 32;
  set(opt1, 0);
  opt1[0] = docusp;
  opt1[3] = dodec;
  opt1[5] = 0; ` horno 1
  opt1[6] = 0; ` memblock
  juliantotime(start, time);
  end = start + 32;
  mon = time[1];
  count = findaspectx(start - zone, end, planet1, planet2, asp1, opt1, lon, lat);
  oldxp = -1;
  oldxp1 = -1;
  m = 0;
  m1 = 0;
  set(tot, 0);
  i = 0; for (i < count)
    {
    memval(0, i, &findjdx);
    if (findtypex = 5 && findp1x = MOON)
      {
      if (moonasp[findaspx] = 0) continue;
      }
    zone = gettimezone(place, findjdx);
    juliantotime(findjdx + zone, foundtime);
    if (foundtime[1] != mon)
      break;
    n = foundtime[2];
    if (findtypex = 5 || findtypex = 2)
      {
      j = n - 1;
      pl1[j][tot[j]] = findp1x;
      pl2[j][tot[j]] = findp2x;
      if (findtypex = 2)
        as[j][tot[j]] = -1;              ` conjunct cusp
      else
        as[j][tot[j]] = findaspx;
      tot[j] += 1;
      }
    if (dorot = 0)
      {
      if (oldxp != xp[n])
        {
        m = 0;
        oldxp = xp[n];
        }
      }
    else
      {
      if (oldxp != yp[n])
        {
        m = 0;
        oldxp = yp[n];
        }
      }
    x = 35 + xp[n] * w;
    y = 1 + yp[n] * h + m * 18;
    if (m < maxn)
      {
      putplanet(x, y, findp1x);
      switch (findtypex)
        {
        :2; putnumber(x + 18, y, findp2x); break;
        :5; putaspect(x + 18, y, findaspx); break;
        :7; putstring(x + 22, y, decname[findaspx - 11]); break;
        }
      if (findtypex != 2)
        putplanet(x + 2 * 18, y, findp2x);
      timetostring(foundtime, ds, ts, 1);
      putstring(x + 3 * 18, y, ts);
      if (dohou = 1 && findtypex = 5 && findp2x < ASCENDANT)
        putnumber(x + 45 + 3 * 18, y, housepos[findp2x] + 1);
      }
    m += 1;
    }

` loop ends
  if (hd = 0)
    goto done;
`---------------------------------------------------------------------------------------- retro voc oob ingress
  set(ops, 0);
  set(xp1, 0);
  ops[0] = doret;
  ops[2] = doing;
  ops[6] = dodec;
  ops[7] = dooob;
  ops[8] = domax;
  ops[10] = dovoc;
  move(planet1, planet, 13);
  count = findaspect(start - zone, end, planet, asp, ops, 0, lon, lat, 0);
  m = 0;
  i = 0; for (i < count)
    {
    memval(0, i, &findjd);
    zone = gettimezone(place, findjd);
    juliantotime(findjd + zone, foundtime);
    if (foundtime[1] != mon)
      break;
    n = foundtime[2];
    if (findtype < 2 || findtype = 6 || (findtype >= 12 && findtype <= 16))
      {
      @getxy;
      if (findtype != 16)
        putplanet(x, y, findp1);
      timetostring(foundtime, ds, ts, 1);
      if (findtype = 6)
        {
        putsign(x + 18, y, findp2);
        putstring(x + 2 * 18, y, ts);
        }
      if (findtype < 2)
        {
        putstring(x + 18, y, retronames[findtype]);
        putstring(x + 60, y, ts);
        }
      if (findtype = 12 || findtype = 13)
        {
        putstring(x + 18, y, oobnames[findtype - 12]);
        putstring(x + 60, y, ts);
        }
      if (findtype = 14)
        {
        putstring(x + 18, y, "Zero");
        putstring(x + 60, y, ts);
        }
      if (findtype = 15)
        {
        putstring(x + 18, y, "Max");
        putstring(x + 60, y, ts);
        }
      if (findtype = 16)
        {
        putplanet(x, y, MOON);
        putstring(x + 18, y, "Voc");
        putstring(x + 60, y, ts);
        }
      }
    }
`----------------------------------------------------------------------------------------
  if (doprog = 1)
    {
    progstart = birth + (start - birth) / YEAR;
    progend = progstart + 32 / YEAR;
    set(opt1, 0);
    opt1[0] = 1; ` cusp
    opt1[6] = 0; ` memblock
    k = planet1[MOON];
    planet1[MOON] = 1; ` always use progressive moon
    count = findaspectx(progstart, progend, planet1, planet2, asp1, opt1, lon, lat);
    i = 0; for (i < count)
      {
      memval(0, i, &findjdx);
      findjdx = birth + (findjdx - birth) * YEAR;              ` adjust prog dates
      zone = gettimezone(place, findjdx);
      juliantotime(findjdx + zone, foundtime);
      n = foundtime[2];
      @getxy;
      if (yr[n] < maxn)
        {
        putstring(x, y, "P");
        putplanet(x + 12, y, findp1x);
        if (findtypex = 5)
          {
          putaspect(x + 30, y, findaspx);
          putplanet(x + 12 + 2 * 18, y, findp2x);
          }
        else
          {
          strset(s, "%l %d", "house", findp2x);
          putstring(x + 28, y, s);
          }
        }
      }
    planet1[MOON] = k;
    }
  if (doecl = 1)
    {
    i = 0; count = findeclipse(1, start, end, 1, 1, lon, lat, 0);
    for (i < count)
      {
      memval(1, i, &ecjd);
      zone = gettimezone(place, ecjd);
      juliantotime(ecjd + zone, foundtime);
      timetostring(foundtime, ds, ts, 1);
      if (foundtime[1] != mon)
        continue;
      n = foundtime[2];
      @getxy;
      putbitmap(x, y, 9 - eckind);
      strset(s, "%a %i %s", ecmoon, ecmoon / 30, ts);
      putsymbolstring(x + 20, y, s);
      }
    }

  if (doretx = 1 || dooobx = 1)
    {
    juliantotime(start, time);  ` all retro / oob
    mon = time[1];
    while (mon = time[1])
      {
      n = time[2];
      jd = timetojulian(time);
      if (doretx = 1)
        {
        calculate(1, jd, lon, lat, -1);
        getvelocities(1, velo);
        s[0] = 0;
        i = 0; for (i < 14)
          {
          if (velo[i] < 0)
            strset(s, "%s%p", s, i);
          }
        if (s[0] != 0)
          {
          @getxy;
          putstring(x, y, "Retro");
          putsymbolstring(-4, y, s);
          }
        }

      if (dooobx = 1)
        {
        getdeclinations(1, dec);
        oob = getplanetx(jd, -1, 0);
        s[0] = 0;
        i = 0; for (i < 14)
          {
          if (abs(dec[i]) > oob)
            strset(s, "%s%p", s, i);
          }
        if (s[0] != 0)
          {
          @getxy;
          putstring(x, y, "Oob");
          putsymbolstring(-3, y, s);
          }
        }
      jd += 1;
      juliantotime(jd, time);
      }
    }

  :done;
  visible(1);
  cal = 1;
  return;


:getxy; ` this is for right column only
  y = 5 + yp[n] * h + yr[n] * 18;
  x = xxx + 155 + xp[n] * w;
  yr[n] += 1;
  return;

#putriseset(int x, int y, real jd, char type, char day, char p)
{
juliantotime(jd, time);
zone = gettimezone(place, jd);
real rs = getriseset(jd, p, type, lon, lat, "") + zone;
juliantotime(rs, time);
if (p = MOON && day != time[2])
  return;
timetostring(time, ds, ts, 1);
putstring(x, y, ts);
}

#moonphase(int x, int y, real jd)
{
real sun = getplanetx(jd, SUN, 0), moon = getplanetx(jd, MOON, 0), phase = normalize(moon - sun);
int n = phase / 45;
putbitmap(x, y, n);
strset(s, "%2a", phase);
putstring(x + 20, y, s);
}

#dayofweek(real jd)
{
return ((((integer(jd + .5) - .5) - 2433282 - 1.5) % 7) + 7) % 7;
}

:load;
  fileopen(inifile, FILEREADAB);
  fileread(dodec);
  fileread(doing);
  fileread(doret);
  fileread(dooob);
  fileread(dovoc);
  fileread(docol);
  fileread(place);
  fileread(doprog);
  fileread(planet1);
  fileread(planet2);
  fileread(asp1);
  fileread(moonasp);
  fileread(dorot);
  fileread(size);
  fileread(dohou);
  fileread(docusp);
  fileread(dolap);
  fileread(usebirth);
  fileread(dosunset);
  fileread(domoonset);
  fileread(domoonphase);
  fileread(dotz);
  fileread(dotzday);
  fileread(textfile);
  fileread(doecl);
  fileread(donoon);
  fileread(domax);
  fileread(doretx);
  fileread(dooobx);
  fileclose;
  return;

:save;
  fileopen(inifile, FILEWRITEAB);
  filewrite(dodec);
  filewrite(doing);
  filewrite(doret);
  filewrite(dooob);
  filewrite(dovoc);
  filewrite(docol);
  filewrite(place);
  filewrite(doprog);
  filewrite(planet1);
  filewrite(planet2);
  filewrite(asp1);
  filewrite(moonasp);
  filewrite(dorot);
  filewrite(size);
  filewrite(dohou);
  filewrite(docusp);
  filewrite(dolap);
  filewrite(usebirth);
  filewrite(dosunset);
  filewrite(domoonset);
  filewrite(domoonphase);
  filewrite(dotz);
  filewrite(dotzday);
  filewrite(textfile);
  filewrite(doecl);
  filewrite(donoon);
  filewrite(domax);
  filewrite(doretx);
  filewrite(dooobx);
  fileclose;
  return;

:place;
  if (getplace(place, lon, lat, 1) = 1)
    {
    fill(0, 0, width, height, -2);           ` clear screen for new radius
    @save;
    @go;
    }
  return;

:do;
  fill(0, 0, width, height, -2);           ` clear screen for new radius
  command(GROUP, -1, menunumber, 0);  ` activate the group
  switch (menunumber)
    {
    :0; @go; break;
    :1; @options; break;
    }
  return;

:options;
  visible(0);
  if (hasput = 0)
    @put;
  command(COMBO, 0, 6, monthndx);
  i = 0; for (i < PLANETS)
    putplanet(470, 65 + 20 * i, i);
  i = 0; for (i < ASPECTS)
    putaspect(580, 65 + 20 * i, i);
  visible(1);
  cal = 0;
  return;

:close;
  quit;

#setyear(int n)
{
int year = numstr(yearstr) + n);
strnum(yearstr, year, 0);
editset(-1);
}

:ud;
  if (cal = 0)
    {
    menunumber = 0;
    @do;
    }
  if (updownbutton = -1)
    {
    monthndx -= 1;
    if (monthndx < 0)
      {
      @setyear(-1);
      monthndx = 11;
      }
    }
  else
    {
    if (monthndx = 11)
      @setyear(1);
    monthndx = (monthndx + 1) % 12;
    }
  fill(0, 0, width, height, -2);           ` clear screen
  @go;
  return;

:seteclbitmaps;
  char LunarEclipse[16][17] =
  "     xxxxxx     ",
  "   xxxxxxxxxx   ",
  "  xxx      xxx  ",
  " xx          xx ",
  " xx   xxxx   xx ",
