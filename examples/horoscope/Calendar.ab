  "     xxxxxx     ";
  setbitmap(LunarEclipse, -1);
  setbitmap(SolarEclipse, -1);
  return;

:help;
  help("Help", "You can switch between the Calendar and the Options from the menu.
Progressions are shown on the right hand with a P.
The moon aspects can be set separately.
Control click shows a horoscope for that day.
Shift click shows a texts from Michael Erlewine's transit texts for that day.
Progressive moon will always be shown even when not selected.
");
  return;
:helpnl;
help("NL Help Kalender", "Men kan heen een weer schakelen tussen de kalender en de opties via het menu.
Progressies worden rechts getoond met een P.
Maan aspecten kunnen apart ingesteld.
Control klik toont een horoscoop voor die dag.
Shift click toont Michael Erlewine's transit texten voor die dag.
Progressieve maan wordt altijd getoond ook indien niet geselecteerd.
");
return;

