window(0, 0);
button(900, 5, "Menu", NULL);
command(BUTTON, buttonnumber, 10, 0);
define STARS 1500;
define MAXSORT 360;
char isdec, allasp, riset, apply = 1, dostar[1200], pname[PLANETS][4], sname[SIGNS][4], export, sid, data[15000][55], name[50], s[999], txt, ds[22], ts[11], sorting, textfile[256], str[9999], startxt[2][12] = "stars.txt", "sterren.txt", header[12][22] = "Star", "Longitude", "Mag", "Decl", "Latitude", "Orb", " Altitude", " Azimuth", "Rise", "Setting", "Decl orb", "Distance", place[99], orbstr[9] = "2", magstr[9] = "6", decorbstr[9] = "1", tab[2] = "	", lang = if (language[0] = 'N');
int x, ndx[MAXSORT], i, time[6], j, k, m, n, count, p, mx = command(FUNCTION, 41, 0, 0), my = command(FUNCTION, 41, 1, 0), sorted[MAXSORT], ra = command(FUNCTION, 41, 2, 0);
real orb = 5, decorb, maxdecorb, jd, a, houses[HOUSES], r, info[7], mag = 99, lon, lat, alt, azi, rise, sett, stday = 1 - (3 * 60 + 56) / SECOND, zone, r1[MAXSORT], planet[PLANETS], dec[PLANETS];
$
stday: 24 uur sterretijd = 24 uur - 3 minuut, 56 sec
$
i = 0; for (i < 12)
  strset(data[i], "%l", header[i]);
i = 0; for (i < PLANETS)
  substr(planetname[i], 0, 3, pname[i]);
i = 0; for (i < SIGNS)
  substr(signname[i], 0, 3, sname[i]);
copyhoroscope(-1, 0);
gethoroscopetime(0, time, jd);
gethoroscopeplace(0, place, 0);
getplanets(0, planet);
gethouses(0, houses);
getdeclinations(0, dec);
sid = command(FUNCTION, 11, 0, 0); ` ayanamsha
`layout(0, 0, lo);int, lo[11]
getlonlat(0, lon, lat);
menu(0, "Close", close);
menu(0, "Go", go);
menu(0, "Ayanamsha", aya);
menu(0, "Text", gettext);
menu(0, "Draw", draw);
menu(0, "Export", export);
menu(0, "Help", NULL);
menu(7, "English", help);
menu(7, "Nederlands", helpnl);
strset(textfile, "%s\ab\horoscope\%s", home, startxt[lang]);
@load;
i = 200;
drawgrid(0, 40, width, height - i - 44, 13, 2, 0, 1, 55, &data, cell);
drawgridcmd(0, 1, 75, 0, s);             ` defcolwidth
drawgridcmd(0, 3, 0, 250, s);
drawgridcmd(0, 3, 1, 200, s);
drawgridcmd(0, 11, 0, 1, s);
drawgridcmd(0, 11, 1, 3, s);
i = 2; for (i < 12)
  drawgridcmd(0, 11, i, 4, s);
drawgridcmd(0, 3, 12, 0, s);  ` set hidden to store longitude
memo(0, height - 200, width, 200, 0, 1);
command(MEMO, 8, 1, 0);
label(10, 5, "Orb");
edit(50, 5, 40, orbstr, NULL);
updown(90, 5, 0, ud);
label(150, 5, "Magnitude");
edit(230, 5, 40, magstr, NULL);
updown(270, 5, 1, ud);
label(330, 5, "Declination");
edit(420, 5, 40, decorbstr, NULL);
updown(460, 5, 2, ud);
checkbox(520, 5, "Apply", apply, go);
radiobutton(630, 0, allasp, "Conjunctions", go);
radiobutton(630, 20, allasp, "All", go);
checkbox(800, 5, "Rise / Set", riset, go);
onclose(save);
findfilestr(0, textfile, "");
strset(s, "%scfg/starsort", home);
set(dostar, 1);
getdisk(dostar, s);
@go;
drawgridcmd(0, 12, 0, 1, s);  ` sort on star name
@cell;
command(MENU, 0, 12, 0);
run;

:aya;
  i = 0; for (i < 48)
    {
    ayaname(i, s);
    selectadd(s);
    }
  command(SELECT, 0, sid, 0);
  i = select("Ayanamsha");
  if (i > -1)
   {
   sid = i;
   @go;
   drawgridcmd(0, 12, 0, 1, s);  ` sort on star name
   @cell;
   }
  return;

:ud;
  switch (updownnumber)
    {
    :0; r = numstr(orbstr) + updownbutton / 10; strnum(orbstr, r, 1); break;
    :1; r = numstr(magstr) + updownbutton / 10; strnum(magstr, r, 1); break;
    :2; r = numstr(decorbstr) + updownbutton / 10; strnum(decorbstr, r, 1); break;
    }
  editset(-1);
  @go;
  return;
  
:export;
  export = 1;
  editor(s, 0);
  @go;
  return;
  
:draw;
  if (apply = 0 or count >= MAXSORT)
    return;
  window(-1, 0);
  real asc = command(FUNCTION, 121, 0, 0);
  set(r1, -1);
  m = 0;
  i = 1; for (i <= count)
    {
    drawgridcmd(0, 13, i, 12, s);
    r1[m] = numstr(s);
    ndx[m] = i;
    m += 1;
    }
  sortplanets(r1, sorted, 3, 0);
  window(-2, 0);
  i = 0; for (i < count)
    {
    drawgridcmd(0, 13, i + 1, 0, name);
    name[12] = 0;
    strset(s, "%s %0a", name, r1[i]);
    anglestring(mx, my, -asc + sorted[i], ra, s);
    }
  command(FUNCTION, 42, 0, 0);
  return;

:go;
  gethoroscopetime(0, time, jd);
  command(DRAWGRID, 0, VISIBLE, 0);
  mag = numstr(magstr);
  orb = numstr(orbstr);
  maxdecorb = numstr(decorbstr);
  n = 0;
  p = 13;
  visible(0);
  cursor(1);
  drawgridcmd(0, 6, 2, 0, s);
  if (export = 1)
    str[0] = 0;
  i = 0; for (i < fixedstars)
    {
    if (dostar[i] = 0)
      continue;
    a = fixedstar(i + 1, name, jd, info, sid);
    if (apply = 1 && info[3] > mag) continue;
    x = 1 + (PLANETS + 1) * if (apply = 1);
    if (allasp = 1 && apply = 1) x = PLANETS;
    j = 0; for (j < x)
      {
      if (j < PLANETS && command(FUNCTION, 44, j, 0) = 0)
        continue;                                         ` only allow planets that are in current set
      if (apply = 1)
        {                                                 ` apply all filters like orb etc
        if (j >= PLANETS)
          {
          isdec = if (isdecaspect(info[1], dec[j - 2], decorb, maxdecorb) > 0);
          if (maxdecorb > 0 && (isdec = 0 || decorb > maxdecorb))
            continue;
          }
        else
          {
          isdec = if (isdecaspect(info[1], dec[j], decorb, maxdecorb) > 0);
          if (maxdecorb > 0 && (isdec = 0 || decorb > maxdecorb))
            continue;
          }
        if (allasp = 0)
          {                                                ` only conjunct and opp as/mc
          if (j >= PLANETS)
            r = isangle(planet[j - 2], a, 180, orb);
          else
            r = isangle(planet[j], a, 0, orb);
          k = j - 2 * if (j >= PLANETS);
          m = OPPOSITION * if (j >= PLANETS);
          if (r < 0 || r > orb) continue;
          }
        else
          {                                                 ` all aspects
          char found = 0; m = 0; for (m < ASPECTS)
            {
            r = isangle(planet[j], a, aspectangle[m], orb);
            if (r > -1)
              {
              found = 1;
              k = j;
              break;
              }
            }
          if (found = 0)
            continue;
          }
        }
      strcpy(data[p], name);
      int h = gethouseposp(0, info[0]) + 1;
      char retro = ' ' + 'R' * if (info[6] < 0);
      if (apply = 1)
        strset(data[p + 1], "%1a %i %e %p %d %c", info[0], info[0] / 30, m, k, h, retro);
      else
        strset(data[p + 1], "%1a %i %c", info[0], info[0] / 30, retro);
      if (export = 1)
        {
        strset(s, "%s %s %0a %s %s %s House %d", name, tab, info[0], signname[info[0] / 30], aspectname[m], planetname[k], h);
        editoradd(s);
        }
      strset(data[p + 2], "%5.2f", info[3]);
      strset(data[p + 3], "%4a", info[1]);
      strset(data[p + 4], "%4a", info[2]);
      if (apply = 1)
        strset(data[p + 5], "%4a", r);
      else
        strcpy(data[p + 5], "-");
`      alt = getazalt(0, jd, info[0], info[2], lon, lat, azi);
      alt = getazalt(1, jd, info[5], info[1], lon, lat, azi);
      strset(data[p + 6], "% 4.2f", alt);
      strset(data[p + 7], "%2a", azi);
      if (riset = 1)
        {
        rise = getriseset(jd - stday, -1, 1, lon, lat, name);
        if (rise > 0)
          {
          zone = gettimezone(place, rise);
          juliantotime(rise + zone, time);
          timetostring(time, ds, ts, 1);
          strcpy(data[p + 8], ts);
          }
        sett = getriseset(jd - stday, -1, 0, lon, lat, name);
        if (sett > 0)
          {
          zone = gettimezone(place, sett);
          juliantotime(sett + zone, time);
          timetostring(time, ds, ts, 1);
          strcpy(data[p + 9], ts);
          }
        }
      else
        {
        strcpy(data[p + 8], " ");
        strcpy(data[p + 9], " ");
        }
      if (apply = 1)
        strset(data[p + 10], "%4a", decorb);
      else
        strcpy(data[p + 10], " ");
      strset(data[p + 11], "%5.2f", info[4]);
      strset(data[p + 12], "%f", a);
      n += 1;
      drawgridcmd(0, 6, n + 1, 0, s);
      p += 13;
      }
    }
  getname(0, s);
  strset(s, "%d %l %s", n, "Fixed stars", s);
  setcaption(s);
  command(DRAWGRID, 0, VISIBLE, 1);
  count = n;
  cursor(0);
  drawgridrow = 1;
  @cell;
  visible(1);
  export = 0;
  return;
  
:book;
  strcmd(15, 0, name);
  @getshortname;
  memoclear;
  if (findfilestr(1, name, str) = 1)
    {
    memoadd(name);
    memoadd(str);
    command(MEMO, 10, 0, 0);
    }
  else 
    memoadd("Nothing found");  
  return;

:gettext;
  if (FALSE = getfilename("Fixed Stars Text", "(*.txt)|*.txt", textfile, 1, FILEREADAB, 0))
    return;
  findfilestr(0, textfile, "");
  return;

:getshortname;
  if (strchr(name, 0, ',') > 0)
    m = strchr(name, 0, ',');
  else  
    m = strchr(name, 0, 9);
  name[m] = 0;
  return;

:cell;
  if (drawgridrow = 0 || drawgridcol != 0) return;
  strcpy(name, data[drawgridrow * 13 + drawgridcol]);
  textget(0, n, name);
  @getshortname;
  memoclear;
  if (findfilestr(1, name, str) = 1)
    {
    memoadd(name);
    memoadd(str);
    command(MEMO, 10, 0, 0);
    }
  else
    {
    strset(s, "%s Nothing found", name);
    memoadd(s);
    }
  command(MEMO, 10, 0, 0);
  return;

:close;
  quit;
  
:load;
  fileopen("stars3.set", FILEREADCFG);
  fileread(txt);
  fileread(sorting);
  fileread(mag);
  fileread(textfile);
  fileread(orbstr);
  fileread(magstr);
  fileread(decorbstr);
  fileread(apply);
  fileread(riset);
  fileread(allasp);
  fileclose;
  return;
  
:save;
  fileopen("stars3.set", FILEWRITECFG);
  filewrite(txt);
  filewrite(sorting);
  filewrite(mag);
  filewrite(textfile);
  filewrite(orbstr);
  filewrite(magstr);
  filewrite(decorbstr);
  filewrite(apply);
  filewrite(riset);
  filewrite(allasp);
  fileclose;
  return;  

:help;
  help("Help Fixed Stars", "hor fixstars.jpg
This shows a list of conjunctions to fixed stars. You can uncheck stars you are not interested in by using Options - Extra - Fixed stars.
  
Click on any of the columns to sort the list. 

You can enter a magnitude, only stars with a lesser magnitude (i.e. brighter) will be shown.
You can enter an orb, only stars with a conjunction within that orb will be shown, a value of 0 will ignore aspects.
You can enter a declination orb, only stars with a parallel within that orb will be shown, a value of 0 will ignore aspects.

Deselect Apply to ignore above filters. You can't use Draw this way.

Click on any star name to check the database for text about this star.

It will look these texts up in c:\planetdance\ab\horoscope\stars.txt for the English version and c:\planetdance\ab\horoscope\sterren.txt for the Dutch version, so you can add or change the descriptions in there. You can also choose a text of your own in Options Text. An entry always has to begin with a single line with the name of the star in brackets like [Regulus].");
  return;

:helpnl;
  help("NL Help Vaste Sterren","hor fixstars.jpg
Dit toont een lijst met zgn. 'Vaste Sterren'. In Opties - Extra - Vaste Sterren kun je de sterren (de)selecteren.
Je kunt op iedere kolom klikken om de lijst te sorteren.

Om de sterrenlijst te filteren op lichtintensiteit vul je een getal in bij 'Magnitude'. Slechts de sterren met een grotere lichtintensiteit zullen dan getoond worden.
(Sterren met Magnitude 6 zijn nog net met het blote oog zichtbaar. Hoe lager het getal, hoe beter zichtbaar de ster.)

Alleen sterren met een conjunctie binnen de orb worden getoond, geef 0 op om dit te negeren.
Alleen sterren met een parallel aspect binnen de declinatie orb worden getoond, geef 0 op om dit te negeren.

Als Toepassen wordt uitgeschakeld, worden bovenstaande filters genegeerd en worden alle sterren in de set getoond. Teken werkt dan niet.

Klik op de naam van een ster, in de rechter kolom of in de lijst, om te zien of er tekst over de ster in de database aanwezig is.
Er wordt dan gezocht in c:\planetdance\ab\horoscope\stars.txt voor de Engelstalige versie en in c:\planetdance\ab\horoscope\sterren.txt voor de Nederlandstalige versie. Dat is dus tegelijk de plaats waar je deze teksten kunt wijzigen of aanvullen. Je kunt ook een tekst naar eigen keuze toevoegen via Opties>Tekst. Een toevoeging moet steeds beginnen als nieuwe lijn met de naam van de ster tussen rechte haakjes zoals [Regulus] .");
  return;