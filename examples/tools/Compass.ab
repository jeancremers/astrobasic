char s[199], cap[99], file[100][260], mapjpg[256], mapinf[256], inifile[256] = "compass.ini", s1[4][22], s2[2][22], map = 1, rose[4][2] = "N", "E", "S", "W", ns = azisouth, hascoor;
`window(screenwidth - 20, screenheight);
window(0, 0);
button(10, height - 30, "&Menu", NULL);
command(BUTTON, 0, 10, 0);
menu(0, "Close", close);
menu(0, "Reset", reset);
menu(0, "Maps", maps);
menu(0, "Help", NULL);
menu(4, "English", help);
menu(4, "Nederlands", helpnl);
real maplon, maplat, maplon1, maplon2, maplat1, maplat2, maplonlen, maplatlen, lon[PLANETS], lat[14], azi, jd, unsorted[PLANETS], la, plon, plat;
int step, wid, len, i, time[6], x, y, n, ndx, sorted[PLANETS], angle, moux, mouy, mx = 200 + (width  - 200) / 2, my = height / 2, x1, y1, nummaps;
@load;
setsymbolsize(1);
copyhoroscope(-1, 0);
getname(0, s);
strset(cap, "%l %s", "Compass", s);
setcaption(cap);     
getplanets(0, lon);     
getlatitudes(0, lat);
gethoroscopetime(0, time, jd);
gettransit(1, -1);
getlonlat(1, plon, plat);             ` gets defaultplace from transit
memget(0, 100, 256);
radiogroup(0, 0, 250, 40, 2, ns, "", "North at 0|South at 0", go);
scrollbar(screenwidth - 100, 50, screenheight - 200, 2500, 1, size);
checkbox(10, 50, "Map", map, go);  
onclose(save);
setlinestyle(4);
strset(s, "%smaps", home);
nummaps = findfiles(s, "*.jpg", 0);
i = 0; for (i < nummaps)
  memval(0, i, &file[i]);
command(FUNCTION, 107, 0, 0); ` disable caption on button bar
@go;
command(MENU, 0, 12, 0);
run;

:maps;
  i = 0; for (i < nummaps)
    selectadd(file[i]);
  n = select("Maps");
  if (n >= 0)
    {
    ndx = n;
    @setmap;
    }
  return;

:go;
  angle = 180 * if (ns = 0);
  command(SCROLLBAR, 0, VISIBLE, map); 
  if (map = 1)
    @setmap;
  else
    @compass;
  return;
  
:compass;
  command(FUNCTION, 37, VISIBLE, 0);
  command(FUNCTION, 37, 14, 0);           ` drawing goes to main surface
  fill(0, 0, width, height, -2);
  command(SCROLLBAR, 0, 8, 0);
  visible(0);
  setlinestyle(1);
  circle(mx, my, 360, -1);
  circle(mx, my, 350, -1);
  circle(mx, my, 340, -1);
  i = 0; for (i < 4)
    {
    getcirclepos(mx, my, 400, 270 - i * 90, x1, y1);
    putstring(x1, y1, rose[i]);
    }
  i = 0; for (i < 360)
    {
    getcirclepos(mx, my, 360, i, x, y);
    getcirclepos(mx, my, 350, i, x1, y1);
    line(x, y, x1, y1, -1);
    }
  i = 0; for (i < 72)
    {
    getcirclepos(mx, my, 350, i * 5, x, y);
    getcirclepos(mx, my, 340, i * 5, x1, y1);
    line(x, y, x1, y1, -1);
    }
  i = 0; for (i < 36)
    {
    strnum(s, (180 + i * 10) % 360, 0);
    getcirclepos(mx, my, 270, i * 10, x, y1);
    anglestring(mx, my, angle - 87 - i * 10, 300, s);
    }
  x1 = 10;
  putstring(x1, 70, "Longitude                 Azimuth");  
  i = 0; for (i < PLANETS)
    {
    y1 = 100 + i * 30;
    getazalt(0, jd, lon[i], 0, plon, plat, azi);
    azi += angle;
    unsorted[i] = azi;
    putplanet(x1, y1, i);
    strset(s, "%1a", lon[i]);
    putstring(x1 + 30, y1, s);
    putsign(x1 + 120, y1, lon[i]/ 30);
    strset(s, "%2a", (angle + azi) % 360);
    putstring(x1 + 160, y1, s);
    }
  sortplanets(unsorted, sorted, 6, 0);  
  i = 0; for (i < PLANETS)
    {
    getazalt(0, jd, lon[i], 0, plon, plat, azi);
    getcirclepos(mx, my, 260, angle + 90 - azi, x, y);
    line(mx, my, x, y, planetcolor[i]);
    getcirclepos(mx, my, 280, 90 - sorted[i], x, y);
    putplanet(x - 8, y - 8, i);
    }
  visible(1);
  return;  


:setmap;
  fill(0, 0, width, height, -2);
  setlinestyle(4);
  command(FUNCTION, 37, VISIBLE, 1);      ` drawing goes to picture
  strset(mapjpg, "%smaps\%s", home, file[ndx]);
  cursor(1);
  picture(mapjpg, moved, down, -1, 0);
  command(FUNCTION, 37, 14, 0);                      ` set drawing to window to turn off cursor
  cursor(0);
  command(FUNCTION, 37, 14, 1);                      ` set drawing back to picture
  command(FUNCTION, 37, 15, 1);                      ` make pic dragable
  wid = command(FUNCTION, 37, 8, 0); ` picture width
  setfilename(mapjpg, ".txt", mapinf, 0);
  fileopen(mapinf, FILEREAD);
  fileread(s);
  fileclose;
  n = split(s, s1, ',');
  hascoor = if (n > 0);
  if (hascoor = 1)
    {
    maplat2 = numstr(s1[0]);                   ` .txt file
    if (strchr(s1[0], 0, 'S') > 0)
      maplat2 *= -1;
    split(s1[0], s2, ' '); 
    maplon1 = numstr(s2[1]);
    if (strchr(s2[1], 0, 'W') > 0)
      maplon1 *= -1;
    maplat1 = numstr(s1[2]);
    if (strchr(s1[2], 0, 'S') > 0)
      maplat1 *= -1;
    split(s1[2], s2, ' '); 
    maplon2 = numstr(s2[1]);
    if (strchr(s2[1], 0, 'W') > 0)
      maplon2 *= -1;
    maplonlen = abs(maplon2 - maplon1);
    maplatlen = abs(maplat2 - maplat1);
    if (maplonlen < 1)
      {
      len = wid / 2;
      step = 5;
      }
    else
      {
      len = 1600 / maplonlen;
      step = maplonlen; 
      }
    }
  else
    {
    len = wid / 8;
    step = 10;
    }
  setlinestyle(4);
  command(SCROLLBAR, 0, 8, 0);
  return;

:reset;
  command(SCROLLBAR, 0, 8, 0);  ` reset scrollbar
  command(FUNCTION, 37, 13, 0); ` reset zoom
  cursor(1);  
  picture(mapjpg, moved, down, -1, 0);
  command(FUNCTION, 37, 15, 1);                      ` make pic dragable
  cursor(0);
  return;

:down;
  if (isbit(mouseinfo, 5) = 0) return; ` control 
  visible(0);
  moux = mousex; ` these can change during this function :)
  mouy = mousey;
  i = 1; for (i < 5)    
    circle(moux, mouy, i, -1);
  if (hascoor = 1)
    {  
    maplon = maplon1 + maplonlen * graphx;    
    maplat = maplat2 - maplatlen * graphy;
    }
  else
    {
    maplon = plon;    
    maplat = plat;
    }  
  i = 0; for (i < PLANETS)
    {
    if (i < PARS) la = lat[i];
    else la = 0;
    getazalt(0, jd, lon[i], la, maplon, maplat, azi);
    unsorted[i] = angle + azi;
    }
  sortplanets(unsorted, sorted, step, 0);  
  int w = command(FUNCTION, 37, 11, 0),
      h = command(FUNCTION, 37, 12, 0);
  i = 0; for (i < PLANETS)
    {
    if (i < PARS) la = lat[i];
    else la = 0;
    getazalt(0, jd, lon[i], la, maplon, maplat, azi);
    getcirclepos(moux, mouy, len, angle + 90 - azi, x, y);
    if (x < 0) x = 0;
    if (x > w) x = w - 20;
    if (y < 0) y = 10;
    if (y > h) y = h - 40;
    line(moux, mouy, x, y, planetcolor[i]);
    getcirclepos(moux, mouy, len + 20, 90 - sorted[i], x, y);
    if (x < 0) x = 0;
    if (x > w) x = w - 20;
    if (y < 0) y = 20;
    if (y > h) y = h - 50;
    putplanet(x - 8, y - 8, i);
    }
  visible(1);
  return;

:moved;
  if (hascoor = 1)
    {
    maplon = maplon1 + maplonlen * graphx;
    maplat = maplat2 - maplatlen * graphy;
    strset(s, "%s %2a %2a", cap, maplon, maplat);
    setcaption(s);
    }
  return;

:size;
  command(FUNCTION, 37, 13, scrollpos[0]); 
  return;

:close; 
  quit;

:help;
  help("Help", "Move the slider to zoom. 
Use control click for a Compass.
Drag the chart with the mouse to move it. 
Use Reset voor de original chart.

You can download extra maps at Help - Download - Maps

How to make maps.
Download https://downloads.sourceforge.net/project/terraincognita2/InstallTI_243.exe
Install and run.
In Map Source, select google classic.
In Zoom Levels, select about 25 km.
Do Selection - Rectangle Selection.
Do Selection - Copy to clipboard. Now open notepad or something and do Paste, save that file with a name like Spain.txt
Do File - save map, choose Oziexplorer. Give it a name like Spain.jpg or something, the names should match.
Copy those two files to c:\planetdance\maps and restart the windrose.
See also ^ Help-Download^.
");
  return;
  
:helpnl;
help("NL Help", "Verplaats de schuifregelaar om in te zoomen.
Gebruik de control-klik om het kompas te tekenen.
Sleep de kaart met de muis om hem te verplaatsen.
Gebruik Reset voor de originele kaart.

U kunt extra kaarten downloaden via Help - Download - Kaarten

Kaarten maken.
Download https://downloads.sourceforge.net/project/terraincognita2/InstallTI_243.exe
Installeren en uitvoeren.
Selecteer Google-klassiek in Map Source.
Selecteer in Zoomniveaus ongeveer 25 km.
Do Selection - Rectangle Selection.
Selectie doen - naar klembord kopiëren. Open nu kladblok of iets en plak het, bewaar dat bestand met een naam als Spain.txt
Bestand doen - kaart opslaan, kies Oziexplorer. Geef het een naam zoals Spain.jpg of zoiets, de namen moeten overeenkomen.
Kopieer die twee bestanden naar c: \ planetdance \ maps en start de windrose opnieuw op.
Zie ook ^ Help-Download^.
");
return;

:load;
  fileopen(inifile, FILEREADAB);
  fileread(ndx);
  fileread(angle);
  fileread(map);
  fileread(ns);
  fileclose;
  return;
  
:save;
  fileopen(inifile, FILEWRITEAB);
  filewrite(ndx);
  filewrite(angle);
  filewrite(map);
  filewrite(ns);
  fileclose;
  return;
  